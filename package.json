{
  "name": "tuxtla-reporta",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @tuxtla/web dev",
    "dev:mobile": "pnpm --filter @tuxtla/mobile start",
    "build": "pnpm --filter @tuxtla/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:mobile": "pnpm --filter @tuxtla/mobile exec jest --runInBand",
    "test:e2e": "playwright test",
    "lint": "eslint apps packages",
    "format": "prettier --write apps packages docs scripts",
    "db:types": "node scripts/generate-types.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "eslint": "10.10.0",
    "typescript-eslint": "8.69.0",
    "supabase": "2.116.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8"
  }
}
